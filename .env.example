# ==============================================================================
# FIRSTSALARY OS BY TEAM DOMINION — ENVIRONMENT CONFIGURATION
# ==============================================================================

# AI Model Configuration (Server-Side: Keys are NEVER exposed to the browser)
# Provide at least one key to enable live cloud AI inference.
# If omitted, FirstSalary OS operates in contextual deterministic financial advisor mode.
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
GROQ_API_KEY=your-groq-api-key

# Supabase Configuration (Optional for local demo mode; Required for cloud sync)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# n8n External Automation Webhook (Optional for testing; Mock Mode active by default)
VITE_N8N_WEBHOOK_URL=https://n8n.your-domain.com/webhook/firstsalary-plan-ready
